{
  "entities": {
    "InterviewFeedback": {
      "title": "InterviewFeedback",
      "description": "Anonymous interview feedback submitted by students or seeded by platform bots.",
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "description": "Company name",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Targeted job role / profile",
          "minLength": 1,
          "maxLength": 100
        },
        "round": {
          "type": "number",
          "description": "Interview round number (1: OA, 2: Tech 1, 3: Tech 2, 4: HR, 5: Composite)"
        },
        "durationMinutes": {
          "type": "number",
          "description": "Round duration in minutes (15 to 240)"
        },
        "overallDifficulty": {
          "type": "string",
          "description": "Overall difficulty rating",
          "enum": ["Easy", "Medium", "Hard"]
        },
        "panelTypes": {
          "type": "array",
          "description": "Selected interviewer backgrounds"
        },
        "questionStyles": {
          "type": "object",
          "description": "Question style percentage breakdown and individual difficulty levels (techPercent, techDifficulty, aiPercent, aiDifficulty, aptitudePercent, aptitudeDifficulty, dsa, systemDesign, behavioral)"
        },
        "topicsTested": {
          "type": "array",
          "description": "Specific topics tested from the topic checklist"
        },
        "technicalQuestions": {
          "type": "string",
          "description": "Optional specific technical and coding questions asked",
          "maxLength": 1500
        },
        "hrQuestions": {
          "type": "string",
          "description": "Optional HR and behavioral questions asked",
          "maxLength": 1500
        },
        "juniorTips": {
          "type": "string",
          "description": "Optional preparation tips and warnings for juniors",
          "maxLength": 1500
        },
        "feedbackType": {
          "type": "string",
          "description": "Origin flag: 'user' for student submission, 'bot' for platform mock entries",
          "enum": ["user", "bot"]
        },
        "submittedAt": {
          "type": "string",
          "description": "Timestamp of submission"
        },
        "collegeDomain": {
          "type": "string",
          "description": "Validated college email domain of author",
          "maxLength": 80
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of student submitter",
          "maxLength": 128
        },
        "submittedByUid": {
          "type": "string",
          "description": "Firebase Auth UID of submitter",
          "maxLength": 128
        },
        "userEmail": {
          "type": "string",
          "description": "Email address of the submitter",
          "maxLength": 100
        },
        "year": {
          "type": "number",
          "description": "Academic graduation year"
        }
      },
      "required": [
        "company",
        "role",
        "round",
        "durationMinutes",
        "overallDifficulty",
        "collegeDomain"
      ]
    },
    "WhitelistedDomain": {
      "title": "WhitelistedDomain",
      "description": "Institutional college email domain approved for campus portal registration.",
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "description": "Official domain suffix e.g. cmrit.ac.in, rvce.edu.in",
          "maxLength": 80
        },
        "collegeName": {
          "type": "string",
          "description": "Full formal name of the institution",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "description": "Domain authorization state",
          "enum": ["active", "disabled"]
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp of domain registration"
        }
      },
      "required": ["domain", "collegeName", "status"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Internships, hackathons, and job opportunities curated or scraped for students.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Job/Hackathon Title",
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "description": "Source platform (e.g., Unstop, Devpost, Adzuna, Direct)",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Opportunity category (Internship, Hackathon, Full-Time, Competition)",
          "maxLength": 50
        },
        "link": {
          "type": "string",
          "description": "Direct application or event URL",
          "maxLength": 500
        },
        "deadline": {
          "type": "string",
          "description": "Application deadline or event date",
          "maxLength": 100
        },
        "location": {
          "type": "string",
          "description": "Job or event location",
          "maxLength": 100
        },
        "requiredSkills": {
          "type": "array",
          "description": "Key tech stack and required skills"
        },
        "descriptionSummary": {
          "type": "string",
          "description": "AI-summarized brief description",
          "maxLength": 2000
        },
        "stipendOrPrize": {
          "type": "string",
          "description": "Stipend amount or prize pool",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["title", "provider", "link"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profile data for registered student or placement coordinator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching auth uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Official college email address",
          "maxLength": 100
        },
        "collegeDomain": {
          "type": "string",
          "description": "Validated college domain e.g. cmrit.ac.in",
          "maxLength": 80
        },
        "displayName": {
          "type": "string",
          "description": "Student full name",
          "maxLength": 100
        },
        "usn": {
          "type": "string",
          "description": "University Seat Number",
          "maxLength": 30
        },
        "branch": {
          "type": "string",
          "description": "Engineering branch (CSE, ISE, AIML, etc.)",
          "maxLength": 50
        },
        "year": {
          "type": "string",
          "description": "Academic graduation year or current class",
          "maxLength": 30
        },
        "collegeName": {
          "type": "string",
          "description": "Full formal name of student's engineering college",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "User permission role",
          "enum": ["student", "admin"]
        },
        "accountType": {
          "type": "string",
          "description": "User identity classifier to distinguish real users from bot reviewers",
          "enum": ["real", "bot"]
        },
        "isBot": {
          "type": "boolean",
          "description": "Flag indicating if the user is a simulated bot account or genuine student"
        },
        "submissionsCount": {
          "type": "number",
          "description": "Number of authentic interview reviews contributed by this user"
        },
        "registeredAt": {
          "type": "string",
          "description": "Timestamp of student account creation"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Timestamp of most recent login"
        }
      },
      "required": ["uid", "email", "collegeDomain"]
    }
  },
  "firestore": {
    "/interview_feedback/{feedbackId}": {
      "schema": {
        "$ref": "InterviewFeedback"
      },
      "description": "Student-submitted and bot-seeded interview feedback reviews"
    },
    "/whitelisted_domains/{domainId}": {
      "schema": {
        "$ref": "WhitelistedDomain"
      },
      "description": "Authorized Bangalore college engineering domains for institutional sign-in validation"
    },
    "/opportunities/{opportunityId}": {
      "schema": {
        "$ref": "Opportunity"
      },
      "description": "Curated and scraped job/internship/hackathon listings"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "UserProfile"
      },
      "description": "Registered student and placement coordinator profile records"
    }
  }
}
