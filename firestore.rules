rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny on root
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9._\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for interview feedback documents
    function isValidFeedback(data) {
      return data.company is string && data.company.size() > 0 && data.company.size() <= 100 &&
             data.role is string && data.role.size() > 0 && data.role.size() <= 100 &&
             (data.round is number || (data.round is string && data.round.size() <= 50)) &&
             data.durationMinutes is number && data.durationMinutes >= 15 && data.durationMinutes <= 240 &&
             data.overallDifficulty in ['Easy', 'Medium', 'Hard'] &&
             (!('panelTypes' in data) || (data.panelTypes is list && data.panelTypes.size() <= 20)) &&
             (!('topicsTested' in data) || (data.topicsTested is list && data.topicsTested.size() <= 60)) &&
             data.collegeDomain is string && data.collegeDomain.size() <= 80 &&
             (!('feedbackType' in data) || data.feedbackType in ['user', 'bot']) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 100)) &&
             (!('submittedByUid' in data) || (data.submittedByUid is string && data.submittedByUid.size() <= 128)) &&
             (!('authorUid' in data) || (data.authorUid is string && data.authorUid.size() <= 128)) &&
             (!('year' in data) || data.year is number) &&
             (!('technicalQuestions' in data) || (data.technicalQuestions is string && data.technicalQuestions.size() <= 1500)) &&
             (!('hrQuestions' in data) || (data.hrQuestions is string && data.hrQuestions.size() <= 1500)) &&
             (!('juniorTips' in data) || (data.juniorTips is string && data.juniorTips.size() <= 1500));
    }

    // 1. Collection: interview_feedback
    // Stores student-submitted and bot-seeded interview feedback reviews.
    // Public list/get. Allow create/update if signed in or if feedbackType == 'bot'.
    match /interview_feedback/{feedbackId} {
      allow list, get: if true;
      allow create, update: if isValidId(feedbackId) && (isSignedIn() || (incoming().feedbackType == 'bot')) && isValidFeedback(incoming());
      allow delete: if isSignedIn() && isValidId(feedbackId);
    }

    // 2. Collection: whitelisted_domains
    // Stores authorized Bangalore college engineering domains for institutional sign-in validation.
    // Allow read/write.
    match /whitelisted_domains/{domainId} {
      allow read, write: if true;
    }

    // 3. Collection: opportunities
    // Stores curated and scraped job/internship/hackathon listings.
    // Allow read/write.
    match /opportunities/{opportunityId} {
      allow read, write: if true;
    }

    // 4. Collection: users
    // Stores registered student profile records in Firestore.
    // Strictly private to authenticated student owner to protect student personal data.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
